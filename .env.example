# Port for local dev & container runs (Vercel automatically assigns its own port)
PORT=3000

# Unified Admin Password for Vercel & Production
# Add this variable in Vercel Project Settings -> Environment Variables
# If left empty, the secure master backup password works by default: Areen#Admin_9X7K!2026
ADMIN_PASSWORD=

# Optional Master Cipher Secret Key (Used for encrypting codes & generating stateless HMAC admin tokens)
CIPHER_SECRET=

# Optional Persistent Data Directory (Defaults to /tmp/areen_data on Vercel)
DATA_DIR=
PERSISTENT_DATA_DIR=

# Optional Gemini API Key
GEMINI_API_KEY=