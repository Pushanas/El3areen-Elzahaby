# Server Port (default: 3000)
PORT=3000

# Admin Master Password for Central Administration Gateway
# (If left empty, system uses secure default: AreenAdmin#2026!Master which can be changed from the dashboard)
ADMIN_PASSWORD=

# Encryption Secret for License Codes Cipher (AES-256-GCM)
CIPHER_SECRET=

# Custom Data Directory path (defaults to ./data locally, or /tmp/areen_data on Vercel)
DATA_DIR=

# Google Gemini API Key (Server-side, optional)
GEMINI_API_KEY=
